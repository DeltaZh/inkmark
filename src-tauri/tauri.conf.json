{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "delta-ink",
  "version": "0.1.0",
  "identifier": "app.delta.ink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "delta-ink",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$APPDATA/**",
          "$HOME/Library/Application Support/abnerworks.Typora/themes/**",
          "$HOME/**/delta-ink*/**/resources/themes/**",
          "$HOME/**/cursorProject/**/resources/themes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
      "resources": [
      "../resources/editor"
    ]
  }
}
